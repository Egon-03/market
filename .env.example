# Database PostgreSQL. In produzione usa la connection string di un database
# gratuito (es. Neon: https://neon.tech — copiala dal loro pannello).
# In locale, se hai Postgres installato: postgresql://utente:password@localhost:5432/market
DATABASE_URL="postgresql://market:market@localhost:5432/market"

# Chiave segreta per firmare i cookie di sessione.
# Generane una con: openssl rand -base64 32
AUTH_SECRET="cambiami-con-una-chiave-segreta-casuale"

# URL pubblico del sito (usato per sitemap, metadati SEO e link nelle e-mail)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ID cliente Google AdSense (es. ca-pub-1234567890123456).
# Lascia vuoto in sviluppo: al suo posto verranno mostrati dei segnaposto.
# Ricordati anche di aggiornare public/ads.txt con il tuo ID publisher.
NEXT_PUBLIC_ADSENSE_CLIENT=""

# SMTP per l'invio delle e-mail (verifica account, notifiche messaggi).
# Consigliato: Brevo (ex Sendinblue), piano gratuito fino a 300 e-mail/giorno.
# Senza SMTP_HOST configurato, le e-mail vengono solo stampate nel log del
# server: comodo in sviluppo, ma in produzione vanno configurate per davvero.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mercatino.ch <noreply@tuodominio.ch>"

# Storage immagini su Cloudflare R2 (piano gratuito: 10GB, nessun costo di
# trasferimento in uscita). Lascia tutto vuoto in sviluppo locale: le foto
# caricate finiranno semplicemente in public/uploads.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# URL pubblico del bucket (dominio R2.dev oppure un tuo dominio collegato)
R2_PUBLIC_URL=""
