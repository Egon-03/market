# Database SQLite (per la produzione puoi passare a PostgreSQL cambiando
# anche il provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Chiave segreta per firmare i cookie di sessione.
# Generane una con: openssl rand -base64 32
AUTH_SECRET="cambiami-con-una-chiave-segreta-casuale"

# URL pubblico del sito (usato per sitemap e metadati SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ID cliente Google AdSense (es. ca-pub-1234567890123456).
# Lascia vuoto in sviluppo: al suo posto verranno mostrati dei segnaposto.
# Ricordati anche di aggiornare public/ads.txt con il tuo ID publisher.
NEXT_PUBLIC_ADSENSE_CLIENT=""

# SMTP per l'invio delle e-mail di verifica (es. Brevo, Mailgun, Postmark…).
# Senza SMTP_HOST configurato, il link di verifica viene stampato nel log
# del server: comodo in sviluppo.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mercatino.ch <noreply@tuodominio.ch>"
