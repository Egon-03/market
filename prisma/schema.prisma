generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  phone              String?
  emailVerified      DateTime?
  verifyToken        String?   @unique
  verifyTokenExpires DateTime?
  role               String    @default("user") // user | admin
  banned             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  listings           Listing[]
  buyerConversations Conversation[] @relation("BuyerConversations")
  messages           Message[]
  reportsMade        Report[]  @relation("ReportsMade")
  reportsReceived    Report[]  @relation("ReportsReceivedAsUser")
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  // Prezzo in CHF. null = "Prezzo da concordare", 0 = "Gratis"
  price       Float?
  category    String
  subcategory String?
  condition   String   @default("usato")
  canton      String
  city        String?
  // JSON array di percorsi immagine
  images      String   @default("[]")
  status      String   @default("attivo") // attivo | venduto
  views       Int      @default(0)
  // Campi specifici veicoli (categoria auto-moto), null per tutte le altre categorie
  brand        String?
  model        String?
  year         Int?
  mileageKm    Int?
  fuelType     String?
  transmission String?
  powerHp      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  reports       Report[]

  @@index([category, status])
  @@index([category, subcategory])
  @@index([canton])
  @@index([createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // L'acquirente che ha avviato la conversazione; il venditore è listing.userId
  buyerId   String
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@unique([listingId, buyerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

/// Segnalazione di un annuncio o di un utente da parte di un membro della
/// community. Esattamente uno tra listingId e reportedUserId è valorizzato,
/// in base al valore di "type".
model Report {
  id             String    @id @default(cuid())
  type           String    // listing | user
  reason         String
  message        String?
  status         String    @default("in_attesa") // in_attesa | risolta | archiviata

  reporterId     String
  reporter       User      @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  listingId      String?
  listing        Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  reportedUserId String?
  reportedUser   User?     @relation("ReportsReceivedAsUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  @@index([status, createdAt])
  @@index([type])
}

/// Contatore per il rate limiting (tentativi di login, registrazioni,
/// invio messaggi…): ogni riga rappresenta un "colpo" per una chiave
/// (es. "login:1.2.3.4") usata per contare le richieste in una finestra
/// temporale. Le righe scadute vengono ripulite in modo pigro a ogni check.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
